# Archivo de variables de entorno (Ejemplo)
# -------------------------------------------------------------
# Copia este archivo como ".env" y reemplaza los valores con
# las credenciales reales de tu API y Base de Datos.
#
# ADVERTENCIA: Nunca subas el archivo ".env" al repositorio.
# -------------------------------------------------------------

# URL base de la futura API de REDSAM (ej. https://api.redsam.pe/v1)
VITE_API_URL="http://localhost:3000/api"

# Clave pública de la API (si es necesaria para las peticiones desde el frontend)
# Nota: En Vite, solo las variables que empiezan con VITE_ son accesibles en el navegador.
VITE_API_PUBLIC_KEY="tu_clave_publica_aqui"

# Otras configuraciones de entorno (ej. entorno de ejecución)
VITE_APP_ENV="development"
