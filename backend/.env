PROJECT_NAME="REDSAM API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Base de datos SQLite para desarrollo local
# Para producción, cambiar a: postgresql+asyncpg://usuario:contraseña@host:5432/redsam_db
DATABASE_URL="sqlite+aiosqlite:///./redsam.db"

SECRET_KEY="SUSTITUIR_POR_UNA_CLAVE_SUPER_SECRETA_Y_LARGA"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — origen del frontend (separar por comas si hay más de uno)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"
