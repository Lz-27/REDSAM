PROJECT_NAME="REDSAM API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
# Formato: postgresql+asyncpg://usuario:contraseña@servidor:puerto/nombre_base_datos
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/redsam_db"

# Security
# Puedes generar una clave segura ejecutando: openssl rand -hex 32
SECRET_KEY="SUSTITUIR_POR_UNA_CLAVE_SUPER_SECRETA_Y_LARGA"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 horas
